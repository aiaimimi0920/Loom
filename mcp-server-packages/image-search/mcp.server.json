{
  "schemaVersion": 1,
  "id": "neuro-image-search",
  "name": "图片搜索",
  "description": "通过 Brave Image Search 提供标准 MCP 图片搜索工具。",
  "version": "0.1.0",
  "publisher": {
    "id": "neuro.official",
    "name": "Neuro"
  },
  "transport": "stdio",
  "entry": {
    "command": "runtime/image-search-mcp.ps1",
    "args": []
  },
  "tools": ["brave_image_search"],
  "credentials": [
    {
      "id": "brave_api_key",
      "label": "Brave API Key",
      "required": true,
      "target": {
        "kind": "env",
        "name": "BRAVE_API_KEY"
      }
    }
  ]
}
