{
  "schemaVersion": 1,
  "id": "stock-api",
  "name": "Stock Market Data",
  "description": "Provides standardized aggregated market quotes via a pinned stock-api version, plus ten-level order books through a pysnowball-compatible live source with Xueqiu fallback.",
  "version": "2.9.0",
  "publisher": {
    "id": "neuro.official",
    "name": "Neuro"
  },
  "transport": "stdio",
  "entry": {
    "command": "runtime/stock-api-mcp.ps1",
    "args": [],
    "platforms": {
      "linux": {
        "command": "runtime/stock-api-entry.js",
        "args": []
      }
    }
  },
  "tools": ["get_stock", "get_stocks", "get_klines", "get_market_series", "get_order_book", "search_stocks", "inspect_stock"],
  "credentials": [
    {
      "id": "pysnowball_token",
      "label": "Xueqiu Cookie (optional)",
      "required": false,
      "target": {
        "kind": "env",
        "name": "LOOM_PYSNOWBALL_TOKEN"
      }
    }
  ]
}
