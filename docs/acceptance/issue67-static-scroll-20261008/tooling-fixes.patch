@@ -0,0 +1,27 @@
+param([ValidateSet('static','scroll','motion')][string]$Mode)
+$ErrorActionPreference='Stop'
+$dir=Join-Path $PSScriptRoot 'source-direct'
+$owned=[IO.File]::ReadAllText("$dir\fixture-owned.json")|ConvertFrom-Json
+$ready=[IO.File]::ReadAllText("$dir\fixture-ready.json")|ConvertFrom-Json
+$p=Get-CimInstance Win32_Process -Filter "ProcessId=$($owned.pid)"
+if(-not$p-or$p.ExecutablePath-ine$owned.path-or$p.CreationDate.ToUniversalTime().ToString('o')-cne$owned.created){throw 'Content fixture identity changed'}
+if(-not('StartupFixtureIdentity' -as [type])){
+    Add-Type @'
+using System;
+using System.Runtime.InteropServices;
+public static class StartupFixtureIdentity {
+ [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr h,out uint p);
+}
+'@
+}
+$h=[IntPtr][Convert]::ToInt64($ready.hwnd.Replace('0x',''),16)
+[uint32]$owner=0
+[void][StartupFixtureIdentity]::GetWindowThreadProcessId($h,[ref]$owner)
+if($owner-ne$owned.pid){throw 'Content fixture HWND owner changed'}
+$end=[DateTime]::UtcNow.AddSeconds(3)
+while(-not(Test-Path "$dir\fixture-state.json")-and[DateTime]::UtcNow-lt$end){Start-Sleep -Milliseconds 50}
+$state=[IO.File]::ReadAllText("$dir\fixture-state.json")|ConvertFrom-Json
+if($state.mode-cne$Mode-or$state.hwnd-cne$ready.hwnd-or$state.revision-ne1){throw 'Fixture startup scenario differs'}
+if($state.timerEnabled-ne($Mode-ne'static')){throw 'Fixture startup timer differs'}
+if($Mode-eq'static'-and($state.ticks-ne0-or$state.phase-ne0)){throw 'Static fixture must not animate'}
+$state|ConvertTo-Json
