+// Unchanged static content may retain its last real frame; never relax identity or image proof.
+export function validateJoinProgress(first, after, image, scenario) {
+  validateScenario(scenario);
+  for (const key of ['relayId', 'liveSessionId', 'sourceDeviceId', 'sourceHookId', 'epoch', 'buildVersion']) {
+    assert(first[key] !== undefined && first[key] !== null, `missing join ${key}`);
+    assert.equal(after[key], first[key], `join ${key} changed`);
+  }
+  assert.equal(after.connectionState, 'connected');
+  assert.equal(after.hasError, false);
+  const a = first.presentation, b = after.presentation;
+  assert(a && b, 'join presentation missing');
+  for (const p of [a, b]) {
+    assert(Number.isSafeInteger(p.frameId) && p.frameId > 0, 'invalid join frame');
+    assert(Number.isSafeInteger(p.generation) && p.generation > 0, 'invalid join generation');
+    assert.equal(p.evidence, 'decoded_submitted');
+  }
+  assert.equal(b.codec, a.codec, 'join codec changed');
+  assert(b.frameId >= a.frameId && b.generation >= a.generation, 'join frame or generation reset');
+  assert(image?.connected && image.complete && image.width > 0 && image.height > 0, 'join image incomplete');
+  assert.equal(image.width, b.width);
+  assert.equal(image.height, b.height);
+  if (scenario !== 'static') {
+    assert(b.frameId > a.frameId, 'Viewer frame did not advance');
+    return;
+  }
+  assert.equal(b.width, a.width, 'static width changed');
+  assert.equal(b.height, a.height, 'static height changed');
+  assert.equal(after.renderEvidenceSupported, true);
+  const r = after.rendering;
+  assert.equal(r?.evidence, 'browser_element_render', 'static render proof missing');
+  assert.equal(r.frameId, b.frameId);
+  assert.equal(r.generation, b.generation);
+  assert(Number.isFinite(r.renderTimeMs) && r.renderTimeMs > 0);
+  assert(Number.isFinite(b.submittedAtMs) && b.submittedAtMs >= 0);
+  assert(Number.isFinite(r.sinceSubmittedMs) && r.sinceSubmittedMs >= 0);
+  assert(Math.abs(r.renderTimeMs - b.submittedAtMs - r.sinceSubmittedMs) < 0.001);
