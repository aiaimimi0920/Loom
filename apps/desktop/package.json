{
  "name": "loom-desktop",
  "version": "0.2.1",
  "description": "Loom desktop shell for the local Loom daemon",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "rsbuild dev --port 1423",
    "test": "node --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "2.1.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.0.0"
  }
}
