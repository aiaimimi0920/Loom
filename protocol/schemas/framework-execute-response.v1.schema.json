{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schemas/framework-execute-response.v1.schema.json",
  "title": "Loom framework execute response v1",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "enum": ["success", "ok", "completed", "error", "failed"] },
    "protocolVersion": { "type": "string" },
    "requestId": { "type": "string" },
    "output": {},
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "candidates": { "type": "array", "items": {} },
    "cache": {},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["started", "progress", "preview", "log", "completed"] },
          "progress": { "type": "number", "minimum": 0, "maximum": 1 },
          "message": { "type": "string" },
          "data": {}
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": ["object", "null"],
      "properties": {
        "durationMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "stdoutBytes": { "type": "integer", "minimum": 0 },
        "stderrBytes": { "type": "integer", "minimum": 0 },
        "stdoutTruncated": { "type": "boolean" },
        "stderrTruncated": { "type": "boolean" },
        "timedOut": { "type": "boolean" },
        "resourceLimited": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
