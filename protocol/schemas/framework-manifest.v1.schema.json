{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schemas/framework-manifest.v1.schema.json",
  "title": "Loom framework package manifest v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "publisher",
    "protocolVersion",
    "platforms",
    "entry",
    "artExecution"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/safeId" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "supportedProtocolVersions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entry": {
      "type": "object",
      "required": ["kind", "command"],
      "properties": {
        "kind": { "const": "process" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "processModel": {
          "enum": ["per_execution", "persistent_worker", "streaming"]
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "keyId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "file"],
      "properties": {
        "algorithm": { "enum": ["ed25519"] },
        "keyId": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "hostCompatibility": {
      "type": "object",
      "properties": {
        "minimum": { "type": "string" },
        "maximum": { "type": "string" }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "permissionPolicy": { "$ref": "#/$defs/permissionPolicy" },
    "resources": { "$ref": "#/$defs/resources" },
    "healthCheck": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "default": "self_test" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 }
      },
      "additionalProperties": false
    },
    "authoringSchema": {
      "$ref": "framework-authoring.v1.schema.json"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "version"],
        "properties": {
          "kind": { "enum": ["framework", "art", "runtime"] },
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "optional": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "artExecution": {
      "type": "object",
      "required": ["requestSchema", "responseSchema"],
      "properties": {
        "requestSchema": { "const": "loom.art.execute.v1" },
        "responseSchema": { "const": "loom.art.result.v1" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9]$|^[A-Za-z0-9]$"
    },
    "permissionPolicy": {
      "type": "object",
      "properties": {
        "network": {
          "type": "object",
          "properties": {
            "domains": { "type": "array", "items": { "type": "string" } },
            "allowLocalhost": { "type": "boolean", "default": false },
            "allowPrivateNetworks": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "properties": {
            "spawn": { "type": "boolean", "default": false },
            "maxProcesses": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "gpu": { "type": "boolean", "default": false },
        "clipboard": { "type": "boolean", "default": false },
        "credentials": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "memoryMiB": { "type": "integer", "minimum": 16 },
        "maxProcesses": { "type": "integer", "minimum": 1 },
        "stdoutMiB": { "type": "integer", "minimum": 1 },
        "stderrMiB": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
