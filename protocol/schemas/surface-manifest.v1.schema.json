{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro.local/schemas/loom/surface-manifest.v1.schema.json",
  "title": "Loom Surface Package Manifest v1",
  "type": "object",
  "required": ["protocolVersion", "apiVersion", "variants"],
  "properties": {
    "protocolVersion": {
      "const": "loom.surface.v1"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "fallbackScene": {
      "type": "string",
      "minLength": 1
    },
    "requiredNodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeIdentifier"
      },
      "uniqueItems": true
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeIdentifier"
      },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "instanceMode": {
      "enum": ["independent", "shared"]
    },
    "stateSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "entry"],
        "properties": {
          "from": { "type": "integer", "minimum": 1 },
          "to": { "type": "integer", "minimum": 1 },
          "entry": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
          }
        },
        "additionalProperties": false
      }
    },
    "minimumSize": {
      "$ref": "#/$defs/size"
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      },
      "minItems": 1
    },
    "defaultViewId": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "themeMode": {
      "enum": ["host", "custom"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["views"]
      },
      "then": {
        "required": ["defaultViewId"]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "runtime": {
      "enum": ["declarative", "javascript", "shader", "loom_remote"]
    },
    "variant": {
      "type": "object",
      "required": ["runtime", "entry"],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safeIdentifier"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": ["id", "risk", "offlinePolicy", "concurrency"],
      "properties": {
        "id": { "$ref": "#/$defs/safeIdentifier" },
        "inputSchema": true,
        "risk": { "enum": ["low", "medium", "high"] },
        "offlinePolicy": { "enum": ["reject", "queue"] },
        "concurrency": {
          "enum": ["replace_latest", "serial", "parallel", "reject_while_running", "coalesce"]
        },
        "idempotent": { "type": "boolean" },
        "confirmation": { "type": "boolean" },
        "cancelable": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "progress": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": ["id", "label", "fullSize"],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fullSize": {
          "$ref": "#/$defs/size"
        }
      },
      "additionalProperties": false
    }
  }
}
