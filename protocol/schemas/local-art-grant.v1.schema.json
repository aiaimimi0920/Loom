{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/protocol/local-art-grant.v1.schema.json",
  "title": "Local Art execution grant envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "keyId", "payload", "signature"],
  "properties": {
    "algorithm": {"const": "ed25519"},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "payload": {"type": "string", "minLength": 1, "maxLength": 21848, "contentEncoding": "base64"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "contentEncoding": "base64"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "requestId", "deviceId", "workspaceId", "instanceId", "generation", "artId", "artVersion", "packageDigest", "sdkVersion"],
      "properties": {
        "origin": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[!-~]+$"},
        "requestId": {"$ref": "#/$defs/identifier"},
        "deviceId": {"$ref": "#/$defs/identifier"},
        "workspaceId": {"$ref": "#/$defs/identifier"},
        "instanceId": {"$ref": "#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/time"},
        "artId": {"type": "string", "minLength": 3, "maxLength": 257, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,127}/[A-Za-z0-9_-][A-Za-z0-9._-]{0,127}$"},
        "artVersion": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9.+-]+$"},
        "packageDigest": {"$ref": "#/$defs/digest"},
        "sdkVersion": {"const": "otter.art.v1"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "digest", "size"],
      "properties": {
        "resourceId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "grantId", "binding", "executionOwner", "resultOwner", "permissions", "services", "issuedAtMs", "expiresAtMs", "offlineUntilMs", "source"],
      "properties": {
        "protocolVersion": {"const": "loom.art.local.grant.v1"},
        "grantId": {"$ref": "#/$defs/identifier"},
        "binding": {"$ref": "#/$defs/binding"},
        "executionOwner": {"const": "otter"},
        "resultOwner": {"const": "otter_workspace"},
        "permissions": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["local_state", "preview", "loom_service", "workspace_result"]}},
        "services": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "issuedAtMs": {"$ref": "#/$defs/time"},
        "expiresAtMs": {"$ref": "#/$defs/time"},
        "offlineUntilMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "source": {"$ref": "#/$defs/source"}
      },
      "$comment": "Runtime validators additionally enforce expiry order, <=15 minute TTL, offline <= expiry, source ID/digest equality, and service permission/allowlist consistency."
    }
  }
}
