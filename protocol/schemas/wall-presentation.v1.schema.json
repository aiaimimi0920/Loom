{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro.local/protocol/wall-presentation.v1.schema.json",
  "title": "Wall v1 presentation-control extension",
  "$defs": {
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "wallId": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,160}$" },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallId", "revision", "mode"],
      "properties": {
        "wallId": { "$ref": "#/$defs/wallId" },
        "revision": { "$ref": "#/$defs/revision" },
        "mode": { "enum": ["frozen", "black"] }
      }
    },
    "presentations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/control" } },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "outcome"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "outcome": { "enum": ["applied", "frame_unavailable"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["baseRevision", "wallId", "mode"],
  "properties": {
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "wallId": { "$ref": "#/$defs/wallId" },
    "mode": { "enum": ["running", "frozen", "black"] }
  }
}
