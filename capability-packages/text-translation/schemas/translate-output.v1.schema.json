{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/capabilities/text-translation/translate-output.v1.schema.json",
  "type": "object",
  "required": ["text", "targetLanguage", "translated"],
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 4096
    },
    "targetLanguage": {
      "enum": ["zh-CN", "en"]
    },
    "translated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
