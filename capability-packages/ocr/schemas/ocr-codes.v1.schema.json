{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro.local/schemas/capabilities/ocr-codes.v1.schema.json",
  "title": "OCR QR/barcode result attachment v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "visible",
    "sourceWidth",
    "sourceHeight",
    "results",
    "surfaceScene"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "visible": { "type": "boolean" },
    "sourceWidth": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "sourceHeight": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "selectedId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "results": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/result" }
    },
    "surfaceScene": { "type": "object" },
    "migration": {
      "type": "object",
      "required": ["source", "version"],
      "properties": {
        "source": { "const": "hook.unitData.barcodeResult" },
        "version": { "const": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["id", "format", "text", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "format": { "type": "string", "minLength": 1, "maxLength": 64 },
        "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "url": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "points": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/point" }
        },
        "bounds": { "$ref": "#/$defs/bounds" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
