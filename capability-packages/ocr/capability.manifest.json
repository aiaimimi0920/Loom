{
  "schemaVersion": 1,
  "kind": "capability",
  "id": "ocr",
  "name": "OCR Recognition",
  "description": "Provides on-demand local OCR, QR/barcode recognition, text copying, and interactive overlays for Otter stickers.",
  "version": "1.3.1",
  "publisher": {
    "id": "neuro.official",
    "keyId": "neuro-official-capability-2"
  },
  "hostCompatibility": {
    "loomCapabilityApi": {
      "minimum": "1.0",
      "requiredFeatures": ["commands.v1", "attachments.v1"]
    },
    "hookExtensionApi": {
      "minimum": "1.0",
      "requiredFeatures": ["commands.v1", "unit-overlays.v1"]
    },
    "surfaceApi": {
      "minimum": "1.0",
      "requiredFeatures": ["declarative.v1"]
    }
  },
  "entrypoints": {
    "service": {
      "targets": {
        "windows-x64": {
          "command": "runtime/loom-ocr-host.exe",
          "args": []
        }
      },
      "processModel": "persistent"
    }
  },
  "activationEvents": [
    "onCommand:neuro.official/ocr.recognize-selected-unit",
    "onCommand:neuro.official/ocr.scan-codes",
    "onOverlay:neuro.official/ocr.result.v1",
    "onOverlay:neuro.official/ocr.codes.v1"
  ],
  "contributes": {
    "commands": [
      {
        "id": "neuro.official/ocr.recognize-selected-unit",
        "title": "Re-recognize and Copy Full OCR Text",
        "description": "Re-recognize the selected sticker, copy the full text, and mark QR codes or barcodes.",
        "inputSchema": "schemas/recognize-input.v1.schema.json",
        "when": "unit.kind == 'sticker' && unit.hasImage",
        "requiresUserGesture": true,
        "cancellable": true,
        "timeoutMs": 60000,
        "permissions": [
          "hook.unit.image.read",
          "hook.unit.attachments.read",
          "hook.unit.attachments.write",
          "hook.clipboard.write",
          "hook.notice.show"
        ]
      },
      {
        "id": "neuro.official/ocr.toggle-overlay",
        "title": "Show or Hide OCR Overlay",
        "when": "unit.kind == 'sticker'",
        "requiresUserGesture": false,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": ["hook.unit.attachments.read", "hook.unit.attachments.write"]
      },
      {
        "id": "neuro.official/ocr.copy-full-text",
        "title": "Copy Full Text",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "requiresUserGesture": true,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": ["hook.unit.attachments.read", "hook.clipboard.write", "hook.notice.show"]
      },
      {
        "id": "neuro.official/ocr.copy-layout-text",
        "title": "Copy with Layout",
        "description": "Restore relative indentation, inter-block spacing, and paragraph breaks from cached OCR coordinates before copying.",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "requiresUserGesture": true,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": ["hook.unit.attachments.read", "hook.clipboard.write", "hook.notice.show"]
      },
      {
        "id": "neuro.official/ocr.copy-selected-text",
        "title": "Copy Selected Text Blocks",
        "description": "Copy OCR text blocks selected via Shift+Click.",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "requiresUserGesture": true,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": ["hook.unit.attachments.read", "hook.clipboard.write", "hook.notice.show"]
      },
      {
        "id": "neuro.official/ocr.copy-block",
        "title": "Copy OCR Text Block",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "requiresUserGesture": true,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": [
          "hook.unit.attachments.read",
          "hook.unit.attachments.write",
          "hook.clipboard.write",
          "hook.notice.show"
        ]
      },
      {
        "id": "neuro.official/ocr.scan-codes",
        "title": "Scan QR Codes / Barcodes",
        "description": "Locally detect QR codes and common barcodes in the selected sticker and display copyable markers.",
        "when": "unit.kind == 'sticker' && unit.hasImage",
        "requiresUserGesture": true,
        "cancellable": true,
        "timeoutMs": 30000,
        "permissions": [
          "hook.unit.image.read",
          "hook.unit.attachments.read",
          "hook.unit.attachments.write",
          "hook.notice.show"
        ]
      },
      {
        "id": "neuro.official/ocr.copy-code",
        "title": "Handle QR Code / Barcode Result",
        "when": "attachment.has('neuro.official/ocr.codes.v1')",
        "requiresUserGesture": true,
        "cancellable": false,
        "timeoutMs": 5000,
        "permissions": [
          "hook.unit.attachments.read",
          "hook.unit.attachments.write",
          "hook.clipboard.write",
          "hook.notice.show",
          "hook.external.open"
        ]
      }
    ],
    "shortcuts": [
      {
        "id": "neuro.official/ocr.shortcut.recognize",
        "command": "neuro.official/ocr.recognize-selected-unit",
        "when": "unit.kind == 'sticker' && unit.hasImage",
        "order": 20,
        "payload": { "keys": "ctrl+4", "global": true }
      },
      {
        "id": "neuro.official/ocr.shortcut.toggle-overlay",
        "command": "neuro.official/ocr.toggle-overlay",
        "when": "unit.kind == 'sticker'",
        "order": 21,
        "payload": { "keys": "alt+4" }
      }
    ],
    "menus": [
      {
        "id": "neuro.official/ocr.menu.copy-full-text",
        "command": "neuro.official/ocr.copy-full-text",
        "title": "Copy Full Text",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "placement": "hook.unit.toolbar",
        "order": 20,
        "payload": {
          "groupId": "neuro.official/ocr.menu",
          "groupTitle": "OCR",
          "disabledTitle": "Press Ctrl+4 to recognize the current sticker first"
        }
      },
      {
        "id": "neuro.official/ocr.menu.copy-layout-text",
        "command": "neuro.official/ocr.copy-layout-text",
        "title": "Copy with Layout",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "placement": "hook.unit.toolbar",
        "order": 21,
        "payload": {
          "groupId": "neuro.official/ocr.menu",
          "groupTitle": "OCR",
          "disabledTitle": "Press Ctrl+4 to recognize the current sticker first"
        }
      },
      {
        "id": "neuro.official/ocr.menu.copy-selected-text",
        "command": "neuro.official/ocr.copy-selected-text",
        "title": "Copy Selected Text Blocks",
        "when": "attachment.has('neuro.official/ocr.result.v1')",
        "placement": "hook.unit.toolbar",
        "order": 22,
        "payload": {
          "groupId": "neuro.official/ocr.menu",
          "groupTitle": "OCR",
          "disabledTitle": "Shift+Click to select OCR text blocks first"
        }
      }
    ],
    "dataTypes": [
      {
        "id": "neuro.official/ocr.result.v1",
        "schema": "schemas/ocr-result.v1.schema.json",
        "payload": { "version": "1" }
      },
      {
        "id": "neuro.official/ocr.codes.v1",
        "schema": "schemas/ocr-codes.v1.schema.json",
        "payload": { "version": "1" }
      }
    ],
    "renderers": [
      {
        "id": "neuro.official/ocr.result-overlay",
        "command": "neuro.official/ocr.copy-block",
        "schema": "renderer.v1",
        "payload": {
          "typeId": "neuro.official/ocr.result.v1",
          "bounds": { "x": 0, "y": 0, "width": 8192, "height": 8192 },
          "attachmentScenePath": "/surfaceScene"
        }
      },
      {
        "id": "neuro.official/ocr.codes-overlay",
        "command": "neuro.official/ocr.copy-code",
        "schema": "renderer.v1",
        "payload": {
          "typeId": "neuro.official/ocr.codes.v1",
          "bounds": { "x": 0, "y": 0, "width": 8192, "height": 8192 },
          "attachmentScenePath": "/surfaceScene"
        }
      }
    ],
    "unitOverlays": [],
    "settings": [],
    "backgroundTasks": [],
    "resourceProviders": [],
    "diagnostics": [],
    "eventSubscriptions": []
  },
  "permissions": [
    "hook.unit.image.read",
    "hook.unit.attachments.read",
    "hook.unit.attachments.write",
    "hook.overlay.render",
    "hook.notice.show",
    "hook.clipboard.write",
    "hook.external.open"
  ],
  "resources": {
    "memoryMiB": 1024,
    "maxProcesses": 1,
    "timeoutSeconds": 60,
    "diskMiB": 1024,
    "stderrKiBPerMinute": 64
  },
  "dependencies": [],
  "signature": {
    "algorithm": "ed25519",
    "keyId": "neuro-official-capability-2",
    "file": "signature.json"
  }
}
