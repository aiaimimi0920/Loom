{
  "id": "cli_wrapper",
  "name": "CLI Wrapper Framework",
  "description": "Executes command-line backed Art packages in an isolated process boundary.",
  "version": "0.1.0",
  "publisher": {
    "id": "neuro.official",
    "name": "Neuro"
  },
  "hostCompatibility": {
    "minimum": ">=0.1.0"
  },
  "protocolVersion": "loom.framework.v1",
  "supportedProtocolVersions": ["loom.framework.v1"],
  "platforms": ["windows-x64"],
  "entry": {
    "kind": "process",
    "command": "runtime/loom-framework-cli-wrapper.exe",
    "args": ["--stdio"]
  },
  "permissions": ["process.spawn", "file.read", "file.write"],
  "permissionPolicy": {
    "filesystem": { "read": ["inputs", "packageResources"], "write": ["outputs", "cache"] },
    "process": { "spawn": true, "maxProcesses": 4 }
  },
  "resources": {
    "timeoutSeconds": 120,
    "memoryMiB": 512,
    "maxProcesses": 4,
    "stdoutMiB": 8,
    "stderrMiB": 8
  },
  "healthCheck": {
    "command": "self_test",
    "timeoutSeconds": 15
  },
  "authoringSchema": {
    "schemaVersion": 1,
    "title": "CLI Wrapper Art",
    "description": "Create an Art backed by a local command-line program.",
    "fields": [
      { "id": "command", "label": "Command", "type": "string", "required": true },
      { "id": "args", "label": "Arguments", "type": "string" },
      { "id": "workingDirectory", "label": "Working directory", "type": "path" }
    ],
    "inputs": [
      { "name": "input", "label": "Input", "type": "file", "executionType": "image_path", "required": true }
    ],
    "outputs": [
      { "name": "result", "label": "Result", "type": "file", "executionType": "image_path" }
    ]
  },
  "artExecution": {
    "requestSchema": "loom.art.execute.v1",
    "responseSchema": "loom.art.result.v1"
  }
}
