{
  "id": "python_art",
  "name": "Python Art Framework",
  "description": "Executes Python-backed Art packages in an isolated process boundary.",
  "version": "0.1.0",
  "publisher": {
    "id": "neuro.official",
    "name": "Neuro"
  },
  "hostCompatibility": {
    "minimum": ">=0.1.0"
  },
  "protocolVersion": "loom.framework.v1",
  "supportedProtocolVersions": ["loom.framework.v1"],
  "platforms": ["windows-x64"],
  "entry": {
    "kind": "process",
    "command": "runtime/loom-framework-python-art.exe",
    "args": ["--stdio"]
  },
  "permissions": ["process.spawn", "file.read", "file.write"],
  "permissionPolicy": {
    "filesystem": { "read": ["inputs", "packageResources"], "write": ["outputs", "cache", "state"] },
    "process": { "spawn": true, "maxProcesses": 4 }
  },
  "resources": {
    "timeoutSeconds": 120,
    "memoryMiB": 512,
    "maxProcesses": 4,
    "stdoutMiB": 8,
    "stderrMiB": 8
  },
  "healthCheck": {
    "command": "self_test",
    "timeoutSeconds": 15
  },
  "dependencies": [
    { "kind": "runtime", "id": "loom.runtime.python", "version": "^3.12" }
  ],
  "authoringSchema": {
    "schemaVersion": 1,
    "title": "Python Art",
    "description": "Create an Art backed by an installed Python Art package.",
    "fields": [
      { "id": "artId", "label": "Python Art ID", "type": "string", "required": true },
      { "id": "artPath", "label": "Python Art path", "type": "path", "required": true }
    ],
    "inputs": [
      { "name": "input", "label": "Input", "type": "image", "executionType": "image_path", "required": true }
    ],
    "outputs": [
      { "name": "result", "label": "Result", "type": "image", "executionType": "image_path" }
    ]
  },
  "artExecution": {
    "requestSchema": "loom.art.execute.v1",
    "responseSchema": "loom.art.result.v1"
  }
}
