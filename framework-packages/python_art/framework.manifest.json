{
  "id": "python_art",
  "name": "Python Art Framework",
  "description": "Executes Python-backed Art packages in an isolated process boundary.",
  "version": "0.1.0",
  "protocolVersion": "loom.framework.v1",
  "platforms": ["windows-x64"],
  "entry": {
    "kind": "process",
    "command": "runtime/loom-framework-python-art.exe",
    "args": ["--stdio"]
  },
  "permissions": ["process.spawn", "file.read", "file.write"],
  "artExecution": {
    "requestSchema": "loom.art.execute.v1",
    "responseSchema": "loom.art.result.v1"
  }
}
