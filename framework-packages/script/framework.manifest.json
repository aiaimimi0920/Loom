{
  "id": "script",
  "name": "Script Framework",
  "description": "Executes script-backed Art packages in an isolated process boundary.",
  "version": "0.1.0",
  "publisher": {
    "id": "neuro.official",
    "name": "Neuro"
  },
  "hostCompatibility": {
    "minimum": ">=0.1.0"
  },
  "protocolVersion": "loom.framework.v1",
  "supportedProtocolVersions": ["loom.framework.v1"],
  "platforms": ["windows-x64"],
  "entry": {
    "kind": "process",
    "command": "runtime/loom-framework-script.exe",
    "args": ["--stdio"]
  },
  "permissions": ["process.spawn", "file.read", "file.write"],
  "permissionPolicy": {
    "filesystem": { "read": ["inputs", "packageResources"], "write": ["outputs", "cache"] },
    "process": { "spawn": true, "maxProcesses": 4 }
  },
  "resources": {
    "timeoutSeconds": 120,
    "memoryMiB": 512,
    "maxProcesses": 4,
    "stdoutMiB": 8,
    "stderrMiB": 8
  },
  "healthCheck": {
    "command": "self_test",
    "timeoutSeconds": 15
  },
  "authoringSchema": {
    "schemaVersion": 1,
    "title": "Script Art",
    "description": "Create an Art backed by a package-local script.",
    "fields": [
      { "id": "script", "label": "Script path", "type": "path", "required": true },
      { "id": "interpreter", "label": "Interpreter", "type": "enum", "default": "powershell", "options": [
        { "value": "powershell", "label": "PowerShell" },
        { "value": "python", "label": "Python" },
        { "value": "node", "label": "Node.js" }
      ] },
      { "id": "args", "label": "Arguments", "type": "string" }
    ],
    "inputs": [
      { "name": "input", "label": "Input", "type": "image", "executionType": "image_buffer", "required": true }
    ],
    "outputs": [
      { "name": "result", "label": "Result", "type": "image", "executionType": "image_buffer" }
    ]
  },
  "artExecution": {
    "requestSchema": "loom.art.execute.v1",
    "responseSchema": "loom.art.result.v1"
  }
}
