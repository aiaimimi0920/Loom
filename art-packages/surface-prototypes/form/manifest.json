{
  "id": "surface-project-form",
  "name": "项目表单",
  "description": "分布式 Surface 原型：必填与可选参数、即时校验、高风险确认、提交和取消。",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "process"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "submission",
      "label": "提交结果",
      "type": "object"
    }
  ],
  "params": [],
  "metadata": {
    "packageSecurity": {
      "version": "1.0.0",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/surface-project-form",
      "englishName": "surface-project-form",
      "globalId": "NA20260811003"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "项目表单",
        "en-US": "Project Form"
      },
      "descriptions": {
        "zh-CN": "必填与可选参数、即时校验、高风险确认、提交和取消原型。",
        "en-US": "Prototype for required and optional fields, validation, confirmation, submit, and cancellation."
      }
    },
    "dependencies": {
      "framework": "process",
      "frameworkVersion": "^0.1"
    },
    "capabilities": {
      "surface": {
        "protocolVersion": "loom.surface.v1",
        "apiVersion": "1.0",
        "variants": [
          {
            "runtime": "declarative",
            "entry": "surface/main.json"
          }
        ],
        "requiredNodes": ["column", "row", "text", "input", "textarea", "button", "divider", "scroll"],
        "requiredCapabilities": [],
        "minimumSize": {
          "width": 340,
          "height": 300
        },
        "actions": [
          {
            "id": "form_validate",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 10000,
            "progress": false
          },
          {
            "id": "form_notes_input",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 10000,
            "progress": false
          },
          {
            "id": "form_submit",
            "risk": "high",
            "offlinePolicy": "reject",
            "concurrency": "serial",
            "idempotent": false,
            "confirmation": true,
            "cancelable": true,
            "timeoutMs": 15000,
            "progress": true
          },
          {
            "id": "form_cancel",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 10000,
            "progress": false
          }
        ]
      }
    },
    "plugin": {
      "packageVersion": "1.0.0",
      "runtimeMode": "surface-prototype"
    }
  }
}
