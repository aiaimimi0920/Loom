{
  "protocolVersion": "loom.surface.v1",
  "scene": {
    "id": "root",
    "type": "scroll",
    "layout": {
      "maxHeight": 420,
      "overflowY": "auto"
    },
    "children": [
      {
        "id": "content",
        "type": "column",
        "layout": {
          "gap": 12,
          "padding": 12
        },
        "children": [
          {
            "id": "header",
            "type": "row",
            "layout": {
              "align": "center",
              "justify": "space-between",
              "gap": 12
            },
            "children": [
              {
                "id": "title",
                "type": "text",
                "props": {
                  "text": "Device Dashboard"
                }
              },
              {
                "id": "auto_sync",
                "type": "switch",
                "props": {
                  "value": true
                },
                "events": {
                  "change": "dashboard_toggle"
                },
                "accessibility": {
                  "label": "Auto sync"
                }
              }
            ]
          },
          {
            "id": "sync_status",
            "type": "text",
            "props": {
              "text": "Waiting to sync"
            },
            "accessibility": {
              "label": "Sync status",
              "live": "polite"
            }
          },
          {
            "id": "sync_progress",
            "type": "progress",
            "props": {
              "value": 0,
              "max": 1
            },
            "accessibility": {
              "label": "Sync progress"
            }
          },
          {
            "id": "divider",
            "type": "divider"
          },
          {
            "id": "devices",
            "type": "column",
            "layout": {
              "gap": 8
            },
            "children": [
              {
                "id": "device_1",
                "type": "text",
                "props": {
                  "text": "Host · Online"
                }
              },
              {
                "id": "device_2",
                "type": "text",
                "props": {
                  "text": "Tablet · Waiting to sync"
                }
              },
              {
                "id": "device_3",
                "type": "text",
                "props": {
                  "text": "Workstation · Online"
                }
              }
            ]
          },
          {
            "id": "chart",
            "type": "image",
            "props": {
              "alt": "Device sync status chart"
            },
            "layout": {
              "width": "100%",
              "height": 96
            }
          },
          {
            "id": "refresh",
            "type": "button",
            "props": {
              "label": "Refresh Dashboard"
            },
            "events": {
              "click": "dashboard_refresh"
            }
          }
        ]
      }
    ]
  },
  "authoritativeState": {
    "autoSync": true,
    "refreshCount": 0,
    "status": "idle"
  }
}
