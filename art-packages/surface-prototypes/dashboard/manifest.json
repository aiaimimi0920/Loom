{
  "id": "surface-device-dashboard",
  "name": "设备仪表板",
  "description": "分布式 Surface 原型：列表、进度、资源更新和同一实例多端挂载。",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "process"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "dashboard",
      "label": "仪表板状态",
      "type": "object"
    }
  ],
  "params": [],
  "metadata": {
    "packageSecurity": {
      "version": "1.0.0",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/surface-device-dashboard",
      "englishName": "surface-device-dashboard",
      "globalId": "NA20260811002"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "设备仪表板",
        "en-US": "Device Dashboard"
      },
      "descriptions": {
        "zh-CN": "列表、进度、资源更新与多设备共享实例原型。",
        "en-US": "Prototype for lists, progress, resource updates, and multi-device attachments."
      }
    },
    "dependencies": {
      "framework": "process",
      "frameworkVersion": "^0.1"
    },
    "capabilities": {
      "surface": {
        "protocolVersion": "loom.surface.v1",
        "apiVersion": "1.0",
        "instanceMode": "shared",
        "variants": [
          {
            "runtime": "declarative",
            "entry": "surface/main.json"
          }
        ],
        "requiredNodes": ["column", "row", "text", "image", "button", "switch", "progress", "divider", "scroll"],
        "requiredCapabilities": ["remote_resources"],
        "minimumSize": {
          "width": 360,
          "height": 300
        },
        "actions": [
          {
            "id": "dashboard_refresh",
            "risk": "low",
            "offlinePolicy": "queue",
            "concurrency": "replace_latest",
            "idempotent": false,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 15000,
            "progress": true
          },
          {
            "id": "dashboard_toggle",
            "risk": "low",
            "offlinePolicy": "queue",
            "concurrency": "serial",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 10000,
            "progress": false
          }
        ]
      }
    },
    "plugin": {
      "packageVersion": "1.0.0",
      "runtimeMode": "surface-prototype"
    }
  }
}
