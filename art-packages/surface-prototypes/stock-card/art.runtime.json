{
  "protocolVersion": "loom.art.runtime.v1",
  "entry": {
    "command": "powershell.exe",
    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "runtime/main.ps1"]
  },
  "limits": {
    "timeoutMs": 30000,
    "maxStdoutBytes": 10485760,
    "maxStderrBytes": 262144,
    "maxProcesses": 1
  }
}
