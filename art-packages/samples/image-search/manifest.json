{
  "id": "custom-image-search",
  "name": "图片搜索",
  "description": "通过 MCP 搜索图片并返回可缓存的候选缩略图。",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "mcp"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "output",
      "label": "搜索结果",
      "type": "image",
      "execution_type": "image_buffer"
    }
  ],
  "params": [
    {
      "id": "query",
      "label": "搜索词",
      "widget": "text",
      "required": true,
      "default": "",
      "data_type": "string"
    },
    {
      "id": "count",
      "label": "候选数量",
      "widget": "slider",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1,
      "data_type": "number"
    },
    {
      "id": "brave_api_key",
      "label": "Brave API Key",
      "type": "secret",
      "required": true
    }
  ],
  "metadata": {
    "packageSecurity": {
      "version": "0.3.2",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/custom-image-search",
      "englishName": "custom-image-search",
      "globalId": "NA20260802003"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "图片搜索",
        "en-US": "Image Search"
      },
      "descriptions": {
        "zh-CN": "通过 MCP 搜索图片并返回可缓存的候选缩略图。",
        "en-US": "Searches for images through MCP and returns cacheable thumbnail candidates."
      }
    },
    "dependencies": {
      "framework": "mcp",
      "frameworkVersion": "^0.2"
    },
    "capabilities": {
      "preview": "image",
      "exports": ["image/png"],
      "parameters": "dynamic",
      "candidates": "image-thumbnails",
      "cache": "eager"
    },
    "mcp": {
      "transport": "stdio",
      "serverId": "neuro-image-search",
      "command": "runtime/image-search-mcp.ps1",
      "args": [],
      "toolName": "brave_image_search",
      "credentialEnv": {
        "BRAVE_API_KEY": "brave_api_key"
      }
    }
  }
}
