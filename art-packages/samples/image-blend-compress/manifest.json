{
  "id": "custom-image-blend-compress-workflow",
  "name": "图片融合并压缩",
  "description": "工作流先调用图片融合 Art，再调用图片压缩 Art，输出最终图片。",
  "enabled": true,
  "execution": {
    "type": "workflow",
    "workflowId": "image-blend-compress-workflow",
    "workflowBindings": {
      "inputs": [
        {
          "workflowParam": "input",
          "nodeId": "blend",
          "target": "input",
          "kind": "input_image"
        },
        {
          "workflowParam": "reference",
          "nodeId": "blend",
          "target": "reference",
          "kind": "param"
        },
        {
          "workflowParam": "mix_ratio",
          "nodeId": "blend",
          "target": "mix_ratio",
          "kind": "param"
        },
        {
          "workflowParam": "quality_num",
          "nodeId": "compress",
          "target": "quality_num",
          "kind": "param"
        }
      ],
      "primaryOutput": {
        "nodeId": "compress",
        "output": "output_base64",
        "kind": "node_result"
      }
    }
  },
  "inputs": [
    {
      "name": "input",
      "label": "图片 A",
      "type": "image",
      "execution_type": "image_buffer"
    },
    {
      "name": "reference",
      "label": "图片 B",
      "type": "image",
      "execution_type": "image_buffer",
      "exposePort": true
    }
  ],
  "outputs": [
    {
      "name": "output",
      "label": "结果",
      "type": "image",
      "execution_type": "image_buffer"
    }
  ],
  "params": [
    {
      "id": "mix_ratio",
      "label": "融合值",
      "widget": "slider",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "data_type": "number"
    },
    {
      "id": "quality_num",
      "label": "压缩比例",
      "widget": "slider",
      "default": 90,
      "min": 60,
      "max": 100,
      "step": 1,
      "data_type": "number"
    }
  ],
  "metadata": {
    "packageSecurity": {
      "version": "0.1.0",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/custom-image-blend-compress-workflow",
      "englishName": "custom-image-blend-compress-workflow",
      "globalId": "NA20260802006"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "图片融合并压缩",
        "en-US": "Image Blend And Compress"
      },
      "descriptions": {
        "zh-CN": "工作流先调用图片融合 Art，再调用图片压缩 Art，输出最终图片。",
        "en-US": "Runs the image-blend Art and then the image-compress Art as a workflow."
      }
    },
    "dependencies": {
      "framework": "workflow",
      "frameworkVersion": "^0.1",
      "arts": [
        "neuro.official/custom-image-blend-script",
        "neuro.official/custom-1770146354922"
      ]
    },
    "capabilities": {
      "preview": "image",
      "exports": ["image/png"],
      "parameters": "dynamic"
    }
  }
}
