{
  "id": "custom-1770146354922",
  "name": "Image Compress",
  "description": "Re-encodes the input image and returns PNG output.",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "process"
  },
  "inputs": [
    {
      "name": "input",
      "label": "Input Image",
      "type": "image",
      "execution_type": "image_buffer"
    }
  ],
  "outputs": [
    {
      "name": "output",
      "label": "Compressed Result",
      "type": "image",
      "execution_type": "image_buffer"
    }
  ],
  "params": [
    {
      "id": "quality_num",
      "label": "Quality",
      "widget": "slider",
      "default": 90,
      "min": 60,
      "max": 100,
      "step": 1,
      "data_type": "number"
    },
    {
      "id": "lossless",
      "label": "Lossless Compression",
      "widget": "checkbox",
      "default": true,
      "data_type": "boolean"
    }
  ],
  "metadata": {
    "packageSecurity": {
      "version": "0.1.2",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/custom-1770146354922",
      "englishName": "custom-1770146354922",
      "globalId": "NA20260802001"
    },
    "localization": {
      "defaultLocale": "en-US",
      "names": {
        "zh-CN": "图片压缩",
        "en-US": "Image Compress"
      },
      "descriptions": {
        "zh-CN": "通过脚本对输入图片重新编码并输出 PNG。",
        "en-US": "Re-encodes the input image and returns PNG output."
      }
    },
    "dependencies": {
      "framework": "process",
      "frameworkVersion": "^0.1"
    },
    "capabilities": {
      "preview": "image",
      "exports": ["image/png"],
      "parameters": "dynamic"
    },
    "plugin": {
      "packageVersion": "1.0.0",
      "runtimeMode": "deterministic-local-adapter"
    }
  }
