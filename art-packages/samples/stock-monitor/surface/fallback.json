{
  "protocolVersion": "loom.surface.v1",
  "scene": {
    "id": "root",
    "type": "column",
    "props": {
      "gap": 10
    },
    "style": {
      "background": "#090c11",
      "color": "#f7f8ef",
      "padding": 14,
      "borderColor": "rgba(255, 255, 255, 0.12)",
      "borderWidth": 1,
      "borderRadius": 4
    },
    "children": [
      {
        "id": "header",
        "type": "row",
        "props": {
          "gap": 8
        },
        "children": [
          {
            "id": "title",
            "type": "text",
            "props": {
              "text": "股票盯盘"
            },
            "style": {
              "color": "#f7f8ef",
              "fontSize": 16,
              "fontWeight": 700
            }
          },
          {
            "id": "status",
            "type": "text",
            "props": {
              "text": "等待首次刷新"
            },
            "style": {
              "color": "#d9ff38",
              "fontSize": 12
            }
          }
        ]
      },
      {
        "id": "controls",
        "type": "row",
        "props": {
          "gap": 8
        },
        "children": [
          {
            "id": "symbol",
            "type": "input",
            "props": {
              "value": "SZ000034",
              "placeholder": "SZ000034 / HK00700 / USAAPL"
            },
            "events": {
              "change": "stock_symbol_commit"
            },
            "accessibility": {
              "label": "股票代码"
            }
          },
          {
            "id": "interval",
            "type": "select",
            "props": {
              "value": "60",
              "options": [
                { "value": "30", "label": "30 秒" },
                { "value": "60", "label": "60 秒" },
                { "value": "120", "label": "2 分钟" },
                { "value": "300", "label": "5 分钟" }
              ]
            },
            "events": {
              "change": "stock_interval_commit"
            },
            "accessibility": {
              "label": "刷新间隔"
            }
          },
          {
            "id": "refresh",
            "type": "button",
            "props": {
              "label": "刷新"
            },
            "events": {
              "click": "stock_refresh"
            },
            "accessibility": {
              "label": "刷新行情"
            }
          }
        ]
      },
      {
        "id": "divider",
        "type": "divider"
      },
      {
        "id": "quote_name",
        "type": "text",
        "props": {
          "text": "SZ000034 · SZ"
        },
        "style": {
          "color": "#929a9f",
          "fontSize": 12
        }
      },
      {
        "id": "quote_price",
        "type": "text",
        "props": {
          "text": "--"
        },
        "style": {
          "color": "#f7f8ef",
          "fontSize": 30,
          "fontWeight": 700
        },
        "accessibility": {
          "label": "当前价格",
          "live": "polite"
        }
      },
      {
        "id": "quote_change",
        "type": "text",
        "props": {
          "text": "等待真实行情"
        },
        "style": {
          "color": "#929a9f",
          "fontSize": 13
        }
      },
      {
        "id": "quote_metrics",
        "type": "text",
        "props": {
          "text": "开 --  高 --  低 --  昨收 --"
        },
        "style": {
          "color": "#929a9f",
          "fontSize": 12
        }
      },
      {
        "id": "provider",
        "type": "text",
        "props": {
          "text": "数据源：stock-api MCP · 行情可能延迟，不构成投资建议或交易指令"
        },
        "style": {
          "color": "#929a9f",
          "fontSize": 11
        }
      }
    ]
  },
  "authoritativeState": {
    "schemaVersion": 2,
    "provider": {
      "id": "stock-api",
      "name": "stock-api"
    },
    "marketScope": "A 股 / 港股 / 美股",
    "code": "SZ000034",
    "market": "SZ",
    "intervalSeconds": 60,
    "status": "idle",
    "statusText": "等待首次刷新",
    "quote": null,
    "history": [],
    "lastUpdatedAt": null,
    "error": null,
    "disclaimer": "行情可能延迟，仅用于信息展示，不构成投资建议或交易指令"
  }
}
