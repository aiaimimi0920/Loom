{
  "protocolVersion": "loom.surface.v1",
  "scene": {
    "id": "root",
    "type": "column",
    "props": {
      "gap": 10
    },
    "style": {
      "background": "#090c11",
      "color": "#f7f8ef",
      "padding": 14,
      "borderColor": "rgba(255, 255, 255, 0.12)",
      "borderWidth": 1,
      "borderRadius": 4
    },
    "children": [
      {
        "id": "header",
        "type": "row",
        "props": {
          "gap": 8
        },
        "children": [
          {
            "id": "title",
            "type": "text",
            "props": {
              "text": "Stock Monitor"
            },
            "style": {
              "color": "#f7f8ef",
              "fontSize": 16,
              "fontWeight": 700
            }
          },
          {
            "id": "status",
            "type": "text",
            "props": {
              "text": "Waiting for initial refresh"
            },
            "style": {
              "color": "#d9ff38",
              "fontSize": 12
            }
          }
        ]
      },
      {
        "id": "controls",
        "type": "row",
        "props": {
          "gap": 8
        },
        "children": [
          {
            "id": "symbol",
            "type": "input",
            "props": {
              "value": "SZ000034",
              "placeholder": "SZ000034 / HK00700 / USAAPL"
            },
            "events": {
              "change": "stock_symbol_commit"
            },
            "accessibility": {
              "label": "Stock code"
            }
          },
          {
            "id": "period",
            "type": "select",
            "props": {
              "value": "minute",
              "options": [
                { "value": "minute", "label": "Intraday" },
                { "value": "five-day", "label": "5D" },
                { "value": "day", "label": "1D" },
                { "value": "week", "label": "1W" },
                { "value": "month", "label": "1M" },
                { "value": "quarter", "label": "1Q" },
                { "value": "year", "label": "1Y" },
                { "value": "minute-120", "label": "120m" },
                { "value": "minute-60", "label": "60m" },
                { "value": "minute-30", "label": "30m" },
                { "value": "minute-15", "label": "15m" },
                { "value": "minute-5", "label": "5m" },
                { "value": "minute-1", "label": "1m" }
              ]
            },
            "events": {
              "change": "stock_period_commit"
            },
            "accessibility": {
              "label": "Market period"
            }
          },
          {
            "id": "interval",
            "type": "select",
            "props": {
              "value": "5",
              "options": [
                { "value": "1", "label": "1s" },
                { "value": "3", "label": "3s" },
                { "value": "5", "label": "5s" },
                { "value": "15", "label": "15s" },
                { "value": "30", "label": "30s" },
                { "value": "60", "label": "1m" },
                { "value": "120", "label": "2m" },
                { "value": "300", "label": "5m" }
              ]
            },
            "events": {
              "change": "stock_interval_commit"
            },
            "accessibility": {
              "label": "Refresh interval"
            }
          },
          {
            "id": "refresh",
            "type": "button",
            "props": {
              "label": "Refresh"
            },
            "events": {
              "click": "stock_refresh"
            },
            "accessibility": {
              "label": "Refresh quote"
            }
          }
        ]
      },
      {
        "id": "divider",
        "type": "divider"
      },
      {
        "id": "quote_name",
        "type": "text",
        "props": {
          "text": "SZ000034 · SZ"
        },
        "style": {
          "color": "#929a9f",
          "fontSize": 12
        }
      },
      {
        "id": "quote_price",
        "type": "text",
        "props": {
          "text": "--"
