{
  "id": "custom-stock-monitor",
  "name": "股票盯盘",
  "description": "通过独立 stock-api MCP 服务聚合行情，并以 pysnowball 兼容实时源观察 A 股、港股与美股报价、分时和多周期 K 线，不提供交易功能。",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "mcp"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "quote",
      "label": "行情快照",
      "type": "object"
    }
  ],
  "params": [
    {
      "id": "code",
      "label": "股票代码",
      "widget": "text",
      "required": true,
      "default": "SZ000034",
      "data_type": "string"
    },
    {
      "id": "interval_seconds",
      "label": "刷新间隔（秒）",
      "widget": "slider",
      "default": 5,
      "min": 1,
      "max": 300,
      "step": 1,
      "data_type": "number"
    }
  ],
  "metadata": {
    "packageSecurity": {
      "version": "1.6.0",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/custom-stock-monitor",
      "englishName": "custom-stock-monitor",
      "globalId": "NA20260802007"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "股票盯盘",
        "en-US": "Stock Monitor"
      },
      "descriptions": {
        "zh-CN": "通过独立 stock-api MCP 服务聚合行情，并以 pysnowball 兼容实时源观察 A 股、港股与美股报价、分时和多周期 K 线，不提供交易功能。",
        "en-US": "Monitors A-share, Hong Kong, and US quotes plus intraday and multi-period candles through stock-api aggregation and a pysnowball-compatible live source, without trading."
      }
    },
    "dependencies": {
      "framework": "mcp",
      "frameworkVersion": "^0.2",
      "mcpServers": [
        {
          "id": "neuro.official/stock-api",
          "version": "=2.9.0"
        }
      ]
    },
    "capabilities": {
      "parameters": "surface",
      "marketData": {
        "providerId": "stock-api",
        "providerName": "stock-api",
        "marketScope": "A 股 / 港股 / 美股",
        "apiKeyRequired": false,
        "trading": false
      },
      "surface": {
        "protocolVersion": "loom.surface.v1",
        "apiVersion": "1.0",
        "variants": [
          {
            "runtime": "javascript",
            "entry": "surface/main.js",
            "requiredCapabilities": ["surface.javascript.v1"]
          },
          {
            "runtime": "declarative",
            "entry": "surface/fallback.json"
          }
        ],
        "fallbackScene": "surface/fallback.json",
        "requiredNodes": ["column", "row", "text", "input", "select", "button", "divider"],
        "requiredCapabilities": [],
        "minimumSize": {
          "width": 320,
          "height": 240
        },
        "views": [
          {
            "id": "full",
            "label": "全视图",
            "fullSize": { "width": 960, "height": 820 }
          },
          {
            "id": "chart-table",
            "label": "折线表格视图",
            "fullSize": { "width": 940, "height": 760 }
          },
          {
            "id": "trade-price",
            "label": "交易价格视图",
            "fullSize": { "width": 620, "height": 620 }
          },
          {
            "id": "favorites-summary",
            "label": "收藏股票价格汇总视图",
            "fullSize": { "width": 640, "height": 420 }
          }
        ],
        "defaultViewId": "full",
        "actions": [
          {
            "id": "stock_refresh",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 50000,
            "progress": true
          },
          {
            "id": "stock_symbol_commit",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 50000,
            "progress": true
          },
          {
            "id": "stock_interval_commit",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 5000,
            "progress": false
          },
          {
            "id": "stock_period_commit",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 50000,
            "progress": true
          },
          {
            "id": "stock_tick_refresh",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 30000,
            "progress": false
          }
        ],
        "instanceMode": "independent",
        "stateSchemaVersion": 2,
        "themeMode": "custom"
      }
    },
    "mcp": {
      "serverId": "stock-api",
      "packageId": "neuro.official/stock-api",
      "version": "=2.9.0",
      "calls": [
        {
          "id": "quote",
          "toolName": "get_stock",
          "arguments": {
            "source": "eastmoney"
          }
        },
        {
          "id": "history",
          "toolName": "get_market_series",
          "arguments": {
            "source": "eastmoney",
            "period": "day",
            "count": 2000,
            "adjust": "none"
          }
        },
        {
          "id": "orderbook",
          "toolName": "get_order_book",
          "arguments": {
            "source": "auto"
          }
        },
        {
          "id": "favorites",
          "toolName": "get_stocks",
          "arguments": {
            "source": "eastmoney",
            "codes": ["SZ000034", "SH600519", "HK00700", "USAAPL"]
          }
        }
      ],
      "surfaceActions": {
        "stock_refresh": {
          "arguments": {
            "code": {
              "from": ["payload.code", "authoritativeState.code"]
            },
            "period": {
              "from": ["authoritativeState.period"]
            }
          }
        },
        "stock_symbol_commit": {
          "arguments": {
            "code": {
              "from": ["payload.value", "authoritativeState.code"]
            },
            "period": {
              "from": ["authoritativeState.period"]
            }
          }
        },
        "stock_interval_commit": {
          "calls": []
        },
        "stock_period_commit": {
          "calls": ["history"],
          "arguments": {
            "code": {
              "from": ["authoritativeState.code"]
            },
            "period": {
              "from": ["payload.value", "authoritativeState.period"]
            }
          }
        },
        "stock_tick_refresh": {
          "calls": ["orderbook"],
          "arguments": {
            "code": {
              "from": ["payload.code", "authoritativeState.code"]
            }
          }
        }
      }
    },
    "marketData": {
      "providerId": "stock-api",
      "providerName": "stock-api",
      "upstreamVersion": "2.7.3",
      "sources": ["tencent", "sina", "eastmoney", "xueqiu", "pysnowball"],
      "marketScope": "A 股 / 港股 / 美股",
      "apiKeyRequired": false,
      "trading": false,
      "disclaimer": "行情可能延迟，仅用于信息展示，不构成投资建议或交易指令"
    },
    "plugin": {
      "packageVersion": "1.6.0",
      "runtimeMode": "surface"
    }
  }
}
