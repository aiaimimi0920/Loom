{
  "id": "custom-stock-monitor",
  "name": "股票盯盘",
  "description": "通过独立 stock-api MCP 服务观察 A 股、港股与美股报价和日 K 线，不提供交易功能。",
  "enabled": true,
  "execution": {
    "type": "framework_art",
    "framework": "mcp"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "quote",
      "label": "行情快照",
      "type": "object"
    }
  ],
  "params": [
    {
      "id": "code",
      "label": "股票代码",
      "widget": "text",
      "required": true,
      "default": "SZ000034",
      "data_type": "string"
    },
    {
      "id": "interval_seconds",
      "label": "刷新间隔（秒）",
      "widget": "slider",
      "default": 60,
      "min": 30,
      "max": 300,
      "step": 30,
      "data_type": "number"
    }
  ],
  "metadata": {
    "packageSecurity": {
      "version": "1.1.0",
      "publisher": {
        "id": "neuro.official",
        "name": "Neuro",
        "icon": "N"
      }
    },
    "art": {
      "qualifiedId": "neuro.official/custom-stock-monitor",
      "englishName": "custom-stock-monitor",
      "globalId": "NA20260802007"
    },
    "localization": {
      "defaultLocale": "zh-CN",
      "names": {
        "zh-CN": "股票盯盘",
        "en-US": "Stock Monitor"
      },
      "descriptions": {
        "zh-CN": "通过独立 stock-api MCP 服务观察 A 股、港股与美股报价和日 K 线，不提供交易功能。",
        "en-US": "Monitors A-share, Hong Kong, and US quotes and daily candles through an independent stock-api MCP service without trading."
      }
    },
    "dependencies": {
      "framework": "mcp",
      "frameworkVersion": "^0.2",
      "mcpServers": [
        {
          "id": "neuro.official/stock-api",
          "version": "=2.7.3"
        }
      ]
    },
    "capabilities": {
      "parameters": "surface",
      "marketData": {
        "providerId": "stock-api",
        "providerName": "stock-api",
        "marketScope": "A 股 / 港股 / 美股",
        "apiKeyRequired": false,
        "trading": false
      },
      "surface": {
        "protocolVersion": "loom.surface.v1",
        "apiVersion": "1.0",
        "variants": [
          {
            "runtime": "javascript",
            "entry": "surface/main.js",
            "requiredCapabilities": ["surface.javascript.v1"]
          },
          {
            "runtime": "declarative",
            "entry": "surface/fallback.json"
          }
        ],
        "fallbackScene": "surface/fallback.json",
        "requiredNodes": ["column", "row", "text", "input", "select", "button", "divider"],
        "requiredCapabilities": [],
        "minimumSize": {
          "width": 360,
          "height": 320
        },
        "actions": [
          {
            "id": "stock_refresh",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 30000,
            "progress": true
          },
          {
            "id": "stock_symbol_commit",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": true,
            "timeoutMs": 30000,
            "progress": true
          },
          {
            "id": "stock_interval_commit",
            "risk": "low",
            "offlinePolicy": "reject",
            "concurrency": "replace_latest",
            "idempotent": true,
            "confirmation": false,
            "cancelable": false,
            "timeoutMs": 5000,
            "progress": false
          }
        ],
        "instanceMode": "independent",
        "stateSchemaVersion": 2,
        "themeMode": "custom"
      }
    },
    "mcp": {
      "serverId": "stock-api",
      "packageId": "neuro.official/stock-api",
      "version": "=2.7.3",
      "calls": [
        {
          "id": "quote",
          "toolName": "get_stock",
          "arguments": {
            "source": "auto"
          }
        },
        {
          "id": "history",
          "toolName": "get_klines",
          "arguments": {
            "source": "auto",
            "period": "day",
            "count": 60,
            "adjust": "none"
          }
        }
      ],
      "surfaceActions": {
        "stock_refresh": {
          "arguments": {
            "code": {
              "from": ["payload.code", "authoritativeState.code"]
            }
          }
        },
        "stock_symbol_commit": {
          "arguments": {
            "code": {
              "from": ["payload.value", "authoritativeState.code"]
            }
          }
        },
        "stock_interval_commit": {
          "calls": []
        }
      }
    },
    "marketData": {
      "providerId": "stock-api",
      "providerName": "stock-api",
      "upstreamVersion": "2.7.3",
      "sources": ["tencent", "sina", "eastmoney"],
      "marketScope": "A 股 / 港股 / 美股",
      "apiKeyRequired": false,
      "trading": false,
      "disclaimer": "行情可能延迟，仅用于信息展示，不构成投资建议或交易指令"
    },
    "plugin": {
      "packageVersion": "1.1.0",
      "runtimeMode": "surface"
    }
  }
}
